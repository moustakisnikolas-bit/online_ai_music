APP_NAME=AION API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://aion:aion@localhost:5432/aion
REDIS_URL=redis://localhost:6379/0
GENERATED_AUDIO_DIR=data/generated/audio
# Synthesizer mode (SoundFont-based instrument playback) -- requires
# FluidSynth installed separately (see docs/15-synthesizer) plus the
# soundfont file at this path (see apps/api/data/soundfonts/README.md).
SOUNDFONT_PATH=data/soundfonts/GeneralUser-GS.sf2
MINIO_ROOT_USER=aion
MINIO_ROOT_PASSWORD=change-me-now
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/publishing/youtube/callback
# Required before connecting a real YouTube channel -- encrypts the stored
# OAuth tokens at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
REPLICATE_API_TOKEN=
STABLE_AUDIO_MODEL=stackadoc/stable-audio-open-1.0
FLUX_MODEL=black-forest-labs/flux-1.1-pro
# OpenRouter is wired up as an alternate AI artwork provider AND an
# optional LLM-based metadata generator, both left dormant (no key) until
# you decide to use them -- see ai_artwork_generator.py and
# llm_metadata_generator.py.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_TEXT_MODEL=anthropic/claude-3.5-haiku
