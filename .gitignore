# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-*/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Auto-generated local encryption key (apps/api/.local_secret_key) --
# created automatically on first use, never committed.
**/.local_secret_key

# OS
.DS_Store
Thumbs.db

# Generated runtime output (produced by the app, not source)
**/data/generated/

# Daily upload-queue snapshots written by scripts/ops/daily_upload_report.py
# (via the "AION Daily Upload Report" scheduled task) -- generated output,
# not source.
**/scripts/ops/daily_reports/

# Sample library audio -- downloaded from Freesound at runtime by
# freesound_importer.py, not source; multi-hundred-MB of .wav files that
# don't belong in git history.
**/data/sample_library/

# SoundFont file for synthesizer mode -- a multi-MB binary asset, not
# source; see apps/api/data/soundfonts/README.md for where to get it.
**/data/soundfonts/*.sf2

# Local-only docker-compose port overrides (this machine has other
# projects' containers occupying the default ports)
docker-compose.override.yml

# Build artifacts
dist/
build/
node_modules/
